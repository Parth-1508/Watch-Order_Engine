<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Package visibility (Android 11 / API 30+): without declaring each
      streaming app's package here, PackageManager.getPackageInfo() and
      getLaunchIntentForPackage() silently fail for apps NOT listed below —
      even when they ARE installed — which would make the 1-tap streaming
      launcher (see util/StreamingLauncher.kt) always fall back to the Play
      Store instead of actually detecting and opening the installed app.
      See: https://developer.android.com/training/package-visibility
    -->
    <queries>
        <package android:name="com.netflix.mediaclient" />
        <package android:name="com.amazon.avod.thirdpartyclient" />
        <package android:name="com.disney.disneyplus" />
        <package android:name="com.crunchyroll.crunchyroid" />
        <package android:name="com.apple.atve.androidtv.appletv" />
        <package android:name="com.wbd.stream" />
        <package android:name="in.startv.hotstar" />
        <package android:name="com.hulu.plus" />
        <package android:name="com.google.android.youtube" />
        <package android:name="com.google.android.videos" />
        <!-- Google Play Store itself, for the "app not installed" fallback -->
        <package android:name="com.android.vending" />
    </queries>

    <application
        android:name=".WatchOrderApplication"
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.WatchOrderEngine">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:hardwareAccelerated="true"
            android:theme="@style/Theme.WatchOrderEngine"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deep Link for Password Reset & Success Redirect -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="watch-order-engine.firebaseapp.com" android:pathPrefix="/success" />
                <data android:scheme="https" android:host="watch-order-engine.web.app" android:pathPrefix="/success" />
                <data android:scheme="https" android:host="watch-order-engine.firebaseapp.com" android:pathPrefix="/__/auth/action" />
                <data android:scheme="https" android:host="watch-order-engine.web.app" android:pathPrefix="/__/auth/action" />
            </intent-filter>
        </activity>

        <service
            android:name=".util.FcmService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>